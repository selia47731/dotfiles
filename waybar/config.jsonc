{
  "layer": "top",
  "position": "top",

  "modules-left": [
    "hyprland/workspace"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "pulseaudio",
    "network",
    "cpu",
    "memory"
  ],

  "clock": {
    "format": "{:%Y-%m-%d %H:%M}"
  },

  "cpu": {
    "format": "CPU {usage}%"
  },

  "memory": {
    "format-ethernet": "ETH",
    "format-discommected": "offline"
  },

  "pulseaudio": {
    "format": "{volume}%"
  }
}
